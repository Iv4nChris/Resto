<section id="hero" class="hero-section section full-screen fade-in">
    <div class="container hero-content">
        <div class="hero-text">
            <h1>@Name</h1>
            <h2>@Title</h2>
            <p>@Summary</p>
            <button class="btn-contact btn-cta" @onclick="ScrollToContact">Let's get started</button>
        </div>
        <div class="profile-container fade-in-delay">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face" alt="Profile Photo" class="profile-image">
        </div>
    </div>
</section>


